# Tracker API the site reads from. Server-side only: the browser never calls it
# directly, so the key below is never shipped in a client bundle.
TRACKER_API_URL=http://localhost:8000
# Optional. Only needed if this deployment shows subscriber-tier data.
TRACKER_API_KEY=

# Public site URL, used for canonical links and the sitemap.
NEXT_PUBLIC_SITE_URL=https://example.org

# Aerial basemap. Not hard-coded because imagery providers' licence terms
# differ by deployment; supply either a full MapLibre style URL or a raster
# tile template.
NEXT_PUBLIC_BASEMAP_STYLE_URL=
NEXT_PUBLIC_BASEMAP_TILE_URL=
NEXT_PUBLIC_BASEMAP_ATTRIBUTION=
