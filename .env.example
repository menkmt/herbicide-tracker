# Copy to .env and edit. Nothing here is committed.

# --- database -----------------------------------------------------------
POSTGRES_USER=tracker
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tracker
POSTGRES_PORT=5432

# --- application --------------------------------------------------------
TRACKER_ENVIRONMENT=development
# Required in production; the app refuses to start with the dev default.
TRACKER_SECRET_KEY=change-me
# Required in production. Authenticates the admin dashboard and admin API.
TRACKER_ADMIN_TOKEN=
TRACKER_PUBLIC_BASE_URL=http://localhost:3000

# --- public deployment ----------------------------------------------------
# Leave these empty for local development. On a server, deploy/enable-domain.sh
# fills them in and Caddy fronts the stack with automatic HTTPS: the site at
# TRACKER_DOMAIN, the API and admin dashboard at api.TRACKER_DOMAIN.
TRACKER_DOMAIN=
# Where Let's Encrypt sends certificate expiry warnings. Optional but wise.
CADDY_EMAIL=
# "public" starts the caddy service; empty leaves ports 80/443 untouched.
COMPOSE_PROFILES=
# Browser login for the admin dashboard, set by deploy/set-admin-password.sh.
# A bcrypt hash; single-quoted so the $ signs are kept literally.
TRACKER_ADMIN_BASIC_HASH=''

# --- source document storage --------------------------------------------
# "local" for a single host, "s3" for an S3-compatible bucket.
TRACKER_STORAGE_BACKEND=local
TRACKER_S3_ENDPOINT_URL=
TRACKER_S3_BUCKET=
TRACKER_S3_ACCESS_KEY_ID=
TRACKER_S3_SECRET_ACCESS_KEY=

# --- aerial basemap ------------------------------------------------------
# Not defaulted to a provider: imagery licence terms differ by deployment.
BASEMAP_TILE_URL=
BASEMAP_ATTRIBUTION=

# --- Inquisitor (monthly CPRA refresh) -----------------------------------
TRACKER_INQUISITOR_ENABLED=false
TRACKER_INQUISITOR_BASE_URL=
TRACKER_INQUISITOR_WORKSPACE_ID=
TRACKER_INQUISITOR_ACTOR=
# Leave false so a person approves records requests before they are sent.
TRACKER_INQUISITOR_AUTO_SEND=false
TRACKER_INQUISITOR_SYNC_DAY=01

# --- optional enrichment -------------------------------------------------
# Web search for public business contact details. Disabled without a key.
TRACKER_WEB_SEARCH_PROVIDER=disabled
TRACKER_WEB_SEARCH_ENDPOINT=
TRACKER_WEB_SEARCH_API_KEY=

# Geocoding. "census" (US Census Geocoder) is the default: public domain,
# keyless, and free of the ODbL share-alike question that OpenStreetMap data
# raises for a product that is sold. See docs/LICENSING.md.
TRACKER_GEOCODER_PROVIDER=census
# Only needed if you switch to nominatim, whose usage policy requires a
# contact address in the User-Agent.
TRACKER_GEOCODER_USER_AGENT=
