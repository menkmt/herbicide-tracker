# Reverse proxy for a public deployment. Loaded by the "caddy" compose service;
# TRACKER_DOMAIN and CADDY_EMAIL come from .env.
#
# Two hostnames rather than path routing under one, because the API and the
# Next.js site both own an /api/ prefix (the site's /api/map/* routes proxy
# the map layers so the browser never needs an API key).
#
#   https://DOMAIN           the public site (Next.js)
#   https://www.DOMAIN       redirects to the above
#   https://api.DOMAIN       the API, its docs at /api/docs, and /admin
#
# Certificates are obtained and renewed automatically. The DNS A records for
# all three names must point at this server before the first start, or the
# ACME challenge fails and Caddy keeps retrying with backoff.

{
	email {$CADDY_EMAIL}
	# HTTP/1.1 and HTTP/2 only. Caddy otherwise advertises HTTP/3 over UDP
	# 443, and a browser that remembers that advert keeps trying QUIC even
	# when UDP is filtered somewhere on the path, failing with
	# ERR_QUIC_PROTOCOL_ERROR instead of falling back. Nothing here needs h3.
	servers {
		protocols h1 h2
	}
}

(hardening) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	encode zstd gzip
}

www.{$TRACKER_DOMAIN} {
	redir https://{$TRACKER_DOMAIN}{uri} permanent
}

{$TRACKER_DOMAIN} {
	import hardening
	reverse_proxy web:3000
}

api.{$TRACKER_DOMAIN} {
	import hardening

	# The admin dashboard, the admin API and the API docs sit behind a
	# browser login (HTTP basic auth, username "admin"). The password hash
	# comes from deploy/set-admin-password.sh. Once past the login, Caddy
	# attaches the application's own admin token to the request, so the
	# person never handles the token and nothing reaches the admin API
	# without first passing the login. The API port is loopback-only, so no
	# one can attach that header from outside.
	@private path /admin* /api/admin/* /api/docs /api/openapi.json
	handle @private {
		basic_auth {
			admin {$TRACKER_ADMIN_BASIC_HASH}
		}
		header X-Robots-Tag "noindex, nofollow"
		request_body {
			max_size 200MB
		}
		reverse_proxy api:8000 {
			header_up X-API-Key {$TRACKER_ADMIN_TOKEN}
			header_up -Authorization
		}
	}

	handle {
		request_body {
			max_size 1MB
		}
		reverse_proxy api:8000
	}
}
